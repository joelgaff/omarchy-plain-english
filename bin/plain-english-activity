#!/usr/bin/env python3
"""Turn raw Linux system statistics into plain English sentences.

Reads /proc and /sys directly -- no dependencies, no root -- samples CPU over a
real interval, and prints one line of JSON describing what the machine is doing
in the words a person would use, not the ones btop uses.

  plain-english-activity            one sample, one JSON line, exit
  plain-english-activity --watch    a JSON line every INTERVAL seconds, forever
  plain-english-activity --text     the same report as readable text

The QML front-end renders the JSON; the --text mode is what makes this
debuggable from a terminal.
"""

import json
import os
import re
import subprocess
import sys
import time

HZ = os.sysconf("SC_CLK_TCK")
PAGE = os.sysconf("SC_PAGE_SIZE")
NCPU = os.cpu_count() or 1

# ---------------------------------------------------------------------------
# Who is this process, in words
# ---------------------------------------------------------------------------
#
# name -> (display name, what it is, kind)
#
# `kind` drives the "should I worry" phrasing later on:
#   app      something you opened; busy is your business
#   browser  an app, but one that is busy for well-understood reasons
#   dev      a compiler, test run, or dev server; busy is the point, and it ends
#   agent    an AI coding agent; busy means it is working
#   system   part of the OS or desktop; busy is usually temporary
#   kernel   the kernel itself; effectively never worth worrying about
#   media    audio/video; busy is expected while something is playing
